# Telegram
BOT_TOKEN=123456:your_bot_token_here

# Admin — this user can manage the whitelist
ADMIN_TELEGRAM_ID=123456789

# Parser API
PARSER_API_URL=http://127.0.0.1:8000
PARSER_API_KEY=

# Bot database (SQLite by default; can be PostgreSQL)
BOT_DB_URL=sqlite:///./bot_data.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Optional: default schedule for new watches
DEFAULT_SCHEDULE=weekly