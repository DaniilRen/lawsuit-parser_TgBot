# Telegram
BOT_TOKEN=123456:your_bot_token_here

# Admin — this user can manage the whitelist and is auto-allowed
ADMIN_TELEGRAM_ID=123456789

# Path to the whitelist file inside the container
WHITELIST_FILE=/app/whitelist.txt

# Parser API
PARSER_API_URL=http://127.0.0.1:5050
PARSER_API_KEY=

# Bot database
BOT_DB_URL=sqlite:///./bot_data.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Default schedule for new watches
DEFAULT_SCHEDULE=weekly